# Runtime mode. "memory" (default) runs rooms in-process with SSE.
# Production multi-instance deployments use PartyKit (PARTYKIT_HOST).
MB_MODE=memory

# Secret for guarding the external sweeper endpoint (/api/sweep) on Vercel / serverless cron
MB_SWEEP_SECRET=

# Vercel-reserved. Set it and Vercel sends `Authorization: Bearer $CRON_SECRET`
# on the cron-invoked GET /api/sweep, which is what authenticates that request.
CRON_SECRET=

# Realtime transport selection (memory or partykit)
NEXT_PUBLIC_MB_MODE=memory
PARTYKIT_HOST=
NEXT_PUBLIC_PARTYKIT_HOST=

# --- Daily games -------------------------------------------------------------
# Persistence for puzzles, attempts and devices. Unset falls back to the
# in-memory store, which is fine for local play and loses everything on restart.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Bearer secret for /api/admin/daily/* (submit, review, approve puzzle content).
# Unset means "open" in development; in production the routes fail closed.
# Local tooling (pnpm daily, the MCP server) reads this from the macOS Keychain:
#   security add-generic-password -U -a "$USER" -s merkive-daily-pipeline -w
# Set it here only for CI or a container.
DAILY_PIPELINE_SECRET=

# How many days of queued puzzles the content pipeline aims to keep ahead.
DAILY_QUEUE_LOOKAHEAD_DAYS=3

